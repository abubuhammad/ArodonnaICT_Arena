generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(uuid())
  name                String
  email               String        @unique
  password            String
  role                UserRole      @default(STUDENT)
  title               String?
  avatar              String?       @default("/images/default-avatar.png")
  bio                 String?
  isAvailableForCall  Boolean       @default(false)
  expertise           Json?
  socialLinks         Json?
  country             String?
  countryCode         String?
  locale              String?       @default("en-US")
  currency            String?       @default("USD")
  bankDetails         Json?
  onboardingCompleted Boolean       @default(false)
  courses             Course[]      @relation("CourseInstructor")
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  gradedAttempts      QuizAttempt[] @relation("GradedAttempts")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  certificateTemplate Json?
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  PENDING
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                 String       @id @default(uuid())
  slug               String       @unique
  title              String
  description        String
  instructor         User         @relation("CourseInstructor", fields: [instructorId], references: [id])
  instructorId       String
  category           Category     @relation(fields: [categoryId], references: [id])
  categoryId         String
  price              Decimal      @db.Decimal(10, 2)
  isFree             Boolean      @default(false)
  thumbnail          String?      @default("/images/course-default.jpg")
  level              String?      @default("Beginner")
  duration           String?      @default("0 hours")
  modules            Module[]
  enrollments        Enrollment[]
  finalAssessment    Json?
  progressPercentage Int          @default(0)
  status             CourseStatus @default(DRAFT)
  publishAt          DateTime?
  reviewRequestedAt  DateTime?
  enrolledStudents   Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Module {
  id          String   @id @default(uuid())
  title       String
  description String
  order       Int
  lessons     Lesson[]
  assessment  Json?
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, order])
}

model Lesson {
  id          String   @id @default(uuid())
  title       String
  description String
  lessonType  String
  content     String
  videoUrl    String?
  duration    String?
  order       Int
  hasQuiz     Boolean  @default(false)
  // quiz data moved to dedicated Quiz/Question models
  module      Module   @relation(fields: [moduleId], references: [id])
  moduleId    String
  quizzes     Quiz[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([moduleId, order])
}

model Question {
  id        String   @id @default(uuid())
  text      String
  type      String // MCQ, ESSAY, CODING, etc.
  options   Json? // for MCQ
  answer    Json? // canonical answer(s)
  tags      Json? // topic, difficulty
  quizzes   Quiz[]   @relation("QuizQuestions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quiz {
  id              String        @id @default(uuid())
  title           String
  lesson          Lesson        @relation(fields: [lessonId], references: [id])
  lessonId        String
  config          Json?
  legacyQuestions Json?
  passingScore    Int
  attemptsAllowed Int           @default(3)
  gradingMode     String        @default("auto")
  questions       Question[]    @relation("QuizQuestions")
  attempts        QuizAttempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model QuizAttempt {
  id           String     @id @default(uuid())
  quiz         Quiz       @relation(fields: [quizId], references: [id])
  quizId       String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  gradedById   String?
  gradedBy     User?      @relation("GradedAttempts", fields: [gradedById], references: [id])
  gradedAt     DateTime?
  attemptNo    Int
  answers      Json
  score        Int?
  status       String // PENDING, PASSED, FAILED
  createdAt    DateTime   @default(now())

  @@index([quizId, userId])
}

model CourseProgress {
  id           String     @id @default(uuid())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId String     @unique
  // structured progress: modules -> lessons statuses, attempts, timestamps
  progress     Json
  timeSpent    Json?
  streaks      Json?
  velocity     Json?
  modules      Json?
  overallScore Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Certificate {
  id           String     @id @default(uuid())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId String
  serial       String     @unique
  issuedAt     DateTime   @default(now())
  fileUrl      String
  revoked      Boolean    @default(false)
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Enrollment {
  id                    String           @id @default(uuid())
  user                  User             @relation(fields: [userId], references: [id])
  userId                String
  course                Course           @relation(fields: [courseId], references: [id])
  courseId              String
  status                EnrollmentStatus @default(ENROLLED)
  paymentStatus         PaymentStatus    @default(NOT_PAID)
  paymentMethod         PaymentMethod?
  paymentReference      String?
  amountPaid            Decimal?         @db.Decimal(12, 2)
  platformShareAmount   Decimal?         @db.Decimal(12, 2)
  instructorShareAmount Decimal?         @db.Decimal(12, 2)
  sharePercentAtPayment Decimal?         @db.Decimal(5, 2)
  progress              Json? // stores module/lesson progress
  progressPercentage    Int              @default(0)
  enrolledAt            DateTime         @default(now())
  startedAt             DateTime?
  moduleProgress        Json?
  finalAssessmentPassed Boolean          @default(false)
  finalScore            Int?
  certificate           Json?
  courseProgress        CourseProgress?
  certificates          Certificate[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenantId              String?
  quizAttempts          QuizAttempt[]

  @@unique([userId, courseId])
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  NOT_PAID
  PENDING
  PAID
  WAIVED
}

enum PaymentMethod {
  PAYSTACK
  BANK_TRANSFER
  FLUTTERWAVE
}

model Theme {
  id                 String   @id @default(uuid())
  name               String   @unique
  primaryColor       String
  secondaryColor     String
  backgroundGradient String
  fontFamily         String?  @default("sans-serif")
  logoUrl             String?
  active             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum CourseStatus {
  DRAFT
  REVIEW
  QA
  PUBLISHED
  ARCHIVED
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actorRole    String?
  actionType   String
  resourceType String
  resourceId   String?
  details      Json?
  tenantId     String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([resourceId, createdAt])
  @@index([actorId, createdAt])
}

model PlatformSetting {
  id                   String   @id @default(uuid())
  platformSharePercent Int      @default(20)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
